+// A window of the embedding app, for the tabs and windows extension APIs,
+// which otherwise only see Chrome style windows. Tiller reports these through
+// tiller_ext_set_window_provider.
+struct TillerWindow {
+  int id = -1;
+  bool focused = false;
+  gfx::Rect bounds;
+  // In tab order. Tabs without a live browser are left out.
+  std::vector<content::WebContents*> tabs;
+  int active_index = -1;
+};
+
+// The app's windows with tabs of |profile| (and its incognito profile when
+// |include_incognito|), the most recently active first, holding only those
+// tabs. Empty when the app reports none.
+std::vector<TillerWindow> GetTillerWindows(Profile* profile,
+                                           bool include_incognito);
+
+// The window holding |contents| and the tab's index in it, from every
+// profile's windows. False when no app window holds it.
+bool GetTillerTab(content::WebContents* contents,
+                  TillerWindow* window,
+                  int* index);
+
 }  // namespace cef
 
 #endif  // CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_CHROME_EXTENSION_UTIL_H_

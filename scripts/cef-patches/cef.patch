   return false;
 }
 
+namespace {
+
+// Calls tiller_ext_add_window once for each window, the most recently active
+// first, synchronously on the UI thread.
+using TillerWindowProvider = void (*)(void* ctx);
+TillerWindowProvider g_provider = nullptr;
+void* g_provider_ctx = nullptr;
+
+// Filled by the provider while GetAllTillerWindows runs.
+std::vector<TillerWindow>* g_collecting = nullptr;
+
+// Window ids handed to extensions, by the app's key for the window, so they
+// don't collide with Chrome style windows' ids.
+std::map<int, SessionID>& WindowIds() {
+  static base::NoDestructor<std::map<int, SessionID>> ids;
+  return *ids;
+}
+
+std::vector<TillerWindow> GetAllTillerWindows() {
+  std::vector<TillerWindow> windows;
+  if (!g_provider || g_collecting) {
+    return windows;
+  }
+  g_collecting = &windows;
+  g_provider(g_provider_ctx);
+  g_collecting = nullptr;
+  return windows;
+}
+
+bool ProfileMatches(content::WebContents* contents,
+                    Profile* profile,
+                    bool include_incognito) {
+  Profile* tab_profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  return tab_profile == profile ||
+         (include_incognito && profile->IsSameOrParent(tab_profile));
+}
+
+}  // namespace
+
+std::vector<TillerWindow> GetTillerWindows(Profile* profile,
+                                           bool include_incognito) {
+  std::vector<TillerWindow> windows;
+  for (auto& window : GetAllTillerWindows()) {
+    content::WebContents* active =
+        window.active_index >= 0
+            ? window.tabs[static_cast<size_t>(window.active_index)]
+            : nullptr;
+    TillerWindow filtered = window;
+    filtered.tabs.clear();
+    filtered.active_index = -1;
+    for (auto* contents : window.tabs) {
+      if (!ProfileMatches(contents, profile, include_incognito)) {
+        continue;
+      }
+      if (contents == active) {
+        filtered.active_index = static_cast<int>(filtered.tabs.size());
+      }
+      filtered.tabs.push_back(contents);
+    }
+    if (!filtered.tabs.empty()) {
+      windows.push_back(std::move(filtered));
+    }
+  }
+  return windows;
+}
+
+bool GetTillerTab(content::WebContents* contents,
+                  TillerWindow* window,
+                  int* index) {
+  for (auto& candidate : GetAllTillerWindows()) {
+    for (size_t i = 0; i < candidate.tabs.size(); ++i) {
+      if (candidate.tabs[i] == contents) {
+        *index = static_cast<int>(i);
+        *window = std::move(candidate);
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
 }  // namespace cef
+
+// The C entry points Tiller finds with dlsym, so the app still runs with a
+// framework that lacks them.
+
+extern "C" __attribute__((visibility("default"))) void
+tiller_ext_set_window_provider(void* ctx, void (*provider)(void* ctx)) {
+  cef::g_provider = provider;
+  cef::g_provider_ctx = ctx;
+}
+
+// Adds one window while the provider runs: |key| is the app's own id for it,
+// |browser_ids| its tabs' browser ids in tab order, and |active_browser_id|
+// the selected tab's. |left| and |top| are from the top left of the primary
+// screen.
+extern "C" __attribute__((visibility("default"))) void tiller_ext_add_window(
+    int key,
+    bool focused,
+    int left,
+    int top,
+    int width,
+    int height,
+    const int* browser_ids,
+    int count,
+    int active_browser_id) {
+  if (!cef::g_collecting) {
+    return;
+  }
+  auto& ids = cef::WindowIds();
+  auto it = ids.find(key);
+  if (it == ids.end()) {
+    it = ids.emplace(key, SessionID::NewUnique()).first;
+  }
+  cef::TillerWindow window;
+  window.id = it->second.id();
+  window.focused = focused;
+  window.bounds = gfx::Rect(left, top, width, height);
+  for (int i = 0; i < count; ++i) {
+    auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_ids[i]);
+    content::WebContents* contents =
+        browser ? browser->GetWebContents() : nullptr;
+    if (!contents) {
+      continue;
+    }
+    if (browser_ids[i] == active_browser_id) {
+      window.active_index = static_cast<int>(window.tabs.size());
+    }
+    window.tabs.push_back(contents);
+  }
+  cef::g_collecting->push_back(std::move(window));
+}

+// Windows of the embedding app (Tiller), whose Alloy style tabs aren't in
+// any Chrome window. They're all of the "normal" type.
+
+bool TillerWindowsMatchFilter(WindowController::TypeFilter filter) {
+  return filter == WindowController::kNoWindowFilter ||
+         (filter & (1 << std::to_underlying(windows::WindowType::kNormal))) !=
+             0;
+}
+
+std::vector<cef::TillerWindow> GetTillerWindowsForFunction(
+    ExtensionFunction* function) {
+  return cef::GetTillerWindows(
+      Profile::FromBrowserContext(function->browser_context()),
+      function->include_incognito_information());
+}
+
+// The window a function's "current window" means: the one holding the
+// calling tab, or else the most recently active.
+const cef::TillerWindow* GetCurrentTillerWindow(
+    ExtensionFunction* function,
+    const std::vector<cef::TillerWindow>& windows) {
+  if (windows.empty()) {
+    return nullptr;
+  }
+  if (content::WebContents* sender = function->GetSenderWebContents()) {
+    for (const auto& window : windows) {
+      if (std::ranges::find(window.tabs, sender) != window.tabs.end()) {
+        return &window;
+      }
+    }
+  }
+  return &windows.front();
+}
+
+// Like BrowserExtensionWindowController::CreateWindowValueForExtension.
+base::DictValue CreateTillerWindowValue(const cef::TillerWindow& window,
+                                        ExtensionFunction* function,
+                                        bool populate_tabs) {
+  base::DictValue dict;
+  dict.Set("id", window.id);
+  dict.Set("type", "normal");
+  dict.Set("focused", window.focused);
+  dict.Set("incognito",
+           !window.tabs.empty() &&
+               window.tabs.front()->GetBrowserContext()->IsOffTheRecord());
+  dict.Set("alwaysOnTop", false);
+  dict.Set("state", "normal");
+  dict.Set("left", window.bounds.x());
+  dict.Set("top", window.bounds.y());
+  dict.Set("width", window.bounds.width());
+  dict.Set("height", window.bounds.height());
+  if (populate_tabs) {
+    base::ListValue tabs;
+    for (size_t i = 0; i < window.tabs.size(); ++i) {
+      tabs.Append(tabs_internal::CreateTabObjectHelper(
+                      window.tabs[i], function->extension(),
+                      function->source_context_type(), nullptr,
+                      static_cast<int>(i))
+                      .ToValue());
+    }
+    dict.Set(ExtensionTabUtil::kTabsKey, std::move(tabs));
+  }
+  return dict;
+}
+
+// Like TabsQueryFunction::MatchesTab, for a tab without a TabInterface: it's
+// never pinned, grouped, split, frozen or discarded.
+bool TillerTabMatches(const tabs::Query::Params::QueryInfo& query,
+                      const Extension* extension,
+                      content::WebContents* contents,
+                      bool active,
+                      const URLPatternSet& url_patterns) {
+  if (!MatchesBool(query.highlighted, active) ||
+      !MatchesBool(query.active, active) || !MatchesBool(query.pinned, false)) {
+    return false;
+  }
+  if ((query.group_id && *query.group_id != -1) ||
+      (query.split_view_id && *query.split_view_id != -1)) {
+    return false;
+  }
+  if (!MatchesBool(query.audible, contents->IsCurrentlyAudible()) ||
+      !MatchesBool(query.frozen, false) ||
+      !MatchesBool(query.discarded, false) ||
+      !MatchesBool(query.auto_discardable, true) ||
+      !MatchesBool(query.muted, contents->IsAudioMuted())) {
+    return false;
+  }
+  bool check_title = query.title && !query.title->empty();
+  if (check_title || !url_patterns.is_empty()) {
+    if (!extension->permissions_data()->HasAPIPermissionForTab(
+            ExtensionTabUtil::GetTabId(contents),
+            mojom::APIPermissionID::kTab) &&
+        !extension->permissions_data()->HasHostPermission(contents->GetURL())) {
+      return false;
+    }
+    if (check_title && !base::MatchPattern(contents->GetTitle(),
+                                           base::UTF8ToUTF16(*query.title))) {
+      return false;
+    }
+    if (!url_patterns.is_empty() &&
+        !url_patterns.MatchesURL(contents->GetURL())) {
+      return false;
+    }
+  }
+  if (query.status != tabs::TabStatus::kNone &&
+      query.status != ExtensionTabUtil::GetLoadingStatus(contents)) {
+    return false;
+  }
+  return true;
+}
+
+// Adds the app's tabs that match to `result`. The app's windows are the
+// current and last focused ones only when no Chrome window is.
+void AppendTillerTabs(ExtensionFunction* function,
+                      const tabs::Query::Params::QueryInfo& query,
+                      const URLPatternSet& url_patterns,
+                      const std::string& window_type,
+                      int window_id,
+                      int tab_index,
+                      bool has_current_browser,
+                      bool has_last_active_browser,
+                      base::ListValue& result) {
+  if (!window_type.empty() && window_type != "normal") {
+    return;
+  }
+  const std::vector<cef::TillerWindow> windows =
+      GetTillerWindowsForFunction(function);
+  const cef::TillerWindow* current =
+      has_current_browser ? nullptr : GetCurrentTillerWindow(function, windows);
+  const cef::TillerWindow* last_active =
+      has_last_active_browser || windows.empty() ? nullptr : &windows.front();
+  for (const auto& window : windows) {
+    if (window_id >= 0 && window_id != window.id) {
+      continue;
+    }
+    if (window_id == extension_misc::kCurrentWindowId && &window != current) {
+      continue;
+    }
+    if (!MatchesBool(query.current_window, &window == current) ||
+        !MatchesBool(query.last_focused_window, &window == last_active)) {
+      continue;
+    }
+    for (size_t i = 0; i < window.tabs.size(); ++i) {
+      const int index = static_cast<int>(i);
+      if (tab_index > -1 && index != tab_index) {
+        continue;
+      }
+      if (!TillerTabMatches(query, function->extension(), window.tabs[i],
+                            index == window.active_index, url_patterns)) {
+        continue;
+      }
+      result.Append(tabs_internal::CreateTabObjectHelper(
+                        window.tabs[i], function->extension(),
+                        function->source_context_type(), nullptr, index)
+                        .ToValue());
+    }
+  }
+}
